# Copy to .env.local and fill in to enable the live dashboard widgets.
# Any left blank simply makes that widget show its "not connected" state.

# Spotify "now playing" widget
# 1. Create an app at https://developer.spotify.com/dashboard (add
#    http://127.0.0.1:3000/callback as a redirect URI).
# 2. Run a one-time OAuth authorize + code exchange with the
#    user-read-currently-playing scope to obtain a refresh token.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# WakaTime coding-stats widget
# Copy your API key from https://wakatime.com/settings/api-key
WAKATIME_API_KEY=
